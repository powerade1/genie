<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.woojin.genie.logview</string>

    <!--
        로그인 시 한 번 Terminal.app 새 창을 띄워 show_logs.sh 를 실행한다.
        Terminal.app 은 .sh 파일을 받으면 새 창에서 실행하므로 별도 자동화
        권한이 필요 없다 (단, Terminal.app 자체에 ~/Desktop 접근 권한은
        필요. 보통 한 번 .sh 를 직접 실행해본 적 있으면 이미 부여돼 있음).

        창을 닫아도 KeepAlive=false 라 다시 안 띄워진다. 다음에 보고 싶으면:
            launchctl kickstart -k gui/$(id -u)/com.woojin.genie.logview
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>Terminal</string>
        <string>/Users/woojin/Desktop/DEV/2_active/genie/scripts/show_logs.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/woojin/Desktop/DEV/2_active/genie</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/woojin</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>ko_KR.UTF-8</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/woojin/Desktop/DEV/2_active/genie/logs/logview.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/woojin/Desktop/DEV/2_active/genie/logs/logview.err.log</string>
</dict>
</plist>
